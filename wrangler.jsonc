{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "image24",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  // After image24.in is attached to Cloudflare, you can enable this: 
  // "routes": [{"pattern":"image24.in","custom_domain":true}],
  "assets": {
    "html_handling": "auto-trailing-slash",
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "image24-production",
      "database_id": "ffc4b922-c6aa-4d70-bc8d-19c96669a67d"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
}
